{
  "$schema": "https://json.schemastore.org/package",
  "name": "@mark1russell7/files",
  "version": "0.0.1",
  "description": "Paths, globs and folder walks on the node: modules only: the home folder, a path inside a folder, find-up, glob patterns to regular expressions, and file walks with excludes.",
  "keywords": [
    "path",
    "paths",
    "glob",
    "globs",
    "minimatch",
    "find-up",
    "walk",
    "files",
    "home",
    "tilde",
    "no-dependencies"
  ],
  "homepage": "https://github.com/mark1russell7/files/tree/main/packages/files#readme",
  "bugs": {
    "url": "https://github.com/mark1russell7/files/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mark1russell7/files.git",
    "directory": "packages/files"
  },
  "license": "MIT",
  "author": "Mark Russell (https://github.com/mark1russell7)",
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./glob": "./src/glob.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "build"
  ],
  "publishConfig": {
    "access": "public",
    "main": "./build/index.js",
    "types": "./build/index.d.ts",
    "exports": {
      ".": {
        "types": "./build/index.d.ts",
        "import": "./build/index.js"
      },
      "./glob": {
        "types": "./build/glob.d.ts",
        "import": "./build/glob.js"
      },
      "./package.json": "./package.json"
    }
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.test.json"
  },
  "devDependencies": {
    "@mark1russell7/cue": "^2.1.2",
    "@types/node": "^26.6.5",
    "esbuild": "^0.28.2",
    "tsdown": "^0.23.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
